[Unit]
Description=Task Node local Fly MPG proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/pfrpc
Environment=PATH=/home/pfrpc/.fly/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pfrpc/.fly/bin/fly mpg proxy zp2wjrejjv5odn4q --bind-addr 127.0.0.1 --local-port 16433
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
